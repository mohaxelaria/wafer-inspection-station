# Copy to .env and edit if you want non-default values.
POSTGRES_USER=wis
POSTGRES_PASSWORD=wis
POSTGRES_DB=wis
WEB_PORT=8000

# The tool loads a 25-wafer lot and starts scanning as soon as it boots,
# so `docker compose up` gives you a moving screen with no clicking.
AUTOSTART=1
AUTOSTART_WAFERS=25
